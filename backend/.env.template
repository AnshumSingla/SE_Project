# ===================================================================
# Smart Reminder - backend environment (copy to .env, never commit it)
# ===================================================================

# --- Google OAuth (from Google Cloud Console) --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Who may use the app ------------------------------------------------
# Any Google account in this domain can sign in (your OAuth app is "Internal").
ALLOWED_DOMAIN=thapar.edu
# Optional extra addresses, comma-separated (only useful if the OAuth app allows them).
ALLOWED_EMAILS=
# The admin: their Drive hosts the encrypted token vault; only they see the one-time setup page.
ADMIN_EMAIL=you@thapar.edu

# Signs the tokens handed to the browser.  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Encrypts every user's refresh token in the vault.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# The ADMIN's Google refresh token (opens the vault). Leave empty, sign in once as the admin,
# and the app shows you the value to paste here.
GOOGLE_REFRESH_TOKEN=

# Shared secret the scheduler sends to /api/cron/scan (16+ random characters).
CRON_SECRET=
# Max users scanned per scheduled run.
CRON_MAX_USERS=50

# --- URLs ---------------------------------------------------------------
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# --- Extraction (optional) ---------------------------------------------
# Without a key the rule-based extractor is used. With one, Gemini runs first and rules are the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Misc ----------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
